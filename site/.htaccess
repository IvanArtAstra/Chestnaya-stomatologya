# Честная стоматология — настройки Apache (Рег.ру и подобные хостинги)

# Своя страница 404 вместо серверной
ErrorDocument 404 /404.html

# Кодировка по умолчанию
AddDefaultCharset UTF-8

# Сжатие текстовых ресурсов
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>

# Кэш: картинки и шрифты — год, css/js — неделя (версия в ?v= обновляет кэш)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType video/mp4  "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css   "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/html  "access plus 0 seconds"
</IfModule>

# Заголовки безопасности
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Служебные файлы наружу не отдаём
<FilesMatch "^(_.*\.html|.*\.md|\.htaccess)$">
  Require all denied
</FilesMatch>
